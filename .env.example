# Local secrets belong in ignored .env, never in this template.
AGECM_MODE=DEMO
DB_URL=jdbc:postgresql://127.0.0.1:5432/agecm_revised
DB_USER=agecm_revised
DB_PASSWORD=agecm_local
INGESTION_TOKEN=local-development-token
BACKEND_URL=http://127.0.0.1:8080
FRONTEND_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
FRONTEND_PORT=5173
REPORT_INTERVAL_SECONDS=20
STALE_SECONDS=65
CLOUD_POLL_SECONDS=5
REQUEST_TIMEOUT_SECONDS=10
REQUEST_RETRIES=2
DEMO_INTERVAL_SECONDS=2
# Optional explicit shared contract path; default resolves config/sensor-contract.json.
SENSOR_CONTRACT_PATH=
THINGSPEAK_BASE_URL=https://api.thingspeak.com
ALLOW_LOCAL_THINGSPEAK_MOCK=false
THINGSPEAK_NODE1_CHANNEL_ID=
THINGSPEAK_NODE1_READ_KEY=
THINGSPEAK_NODE2_CHANNEL_ID=
THINGSPEAK_NODE2_READ_KEY=
# Write keys belong to the respective ESP32 firmware, not the reader or browser.
# No channel writes are authorized by normal website operation.
ENABLE_THINGSPEAK_WRITE_TEST=false
THINGSPEAK_TEST_CHANNEL_ID=
THINGSPEAK_TEST_WRITE_KEY=
