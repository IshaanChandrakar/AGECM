# Local environment and credentials (keep shareable examples)
.env
.env.*
!.env.example
!.env.*.example

# Dependencies and build output
node_modules/
dist/
target/
*.tsbuildinfo
.vite/

# Python environments and caches
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local runtime files and logs
.runtime/
/tmp/
*.log
*.pid

# Generated documents, packages and browser screenshots
# Keep output/imagegen/ masters and frontend/public/ assets versioned.
/output/pdf/
/output/latex/
/output/preview*/

# Downloaded telemetry exports (do not hide CSV fixtures or source data)
agecm-*.csv
/exports/

# Test and coverage reports
test-results/
playwright-report/
playwright/.cache/
coverage/
htmlcov/
.coverage
.coverage.*

# Editor and operating system files
.idea/
.vscode/
*.iml
*.swp
*.swo
.DS_Store
._*
Thumbs.db
Desktop.ini

# Deployment certificates, local exports and backups
/deploy/certs/*
!/deploy/certs/.gitkeep
*.dump
*.dump.gz
/backups/
*.sql.gz
*.sql.zip

# Local cloud credentials and private key material
.aws/
.pgpass
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
