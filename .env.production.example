# Copy to .env.production (ignored), chmod 600, and replace every placeholder.
# No AWS access keys are needed inside any application container.
IMAGE_TAG=release-YYYYMMDD-01
PUBLIC_DOMAIN=monitor.example.com
ACME_EMAIL=operator@example.com
DB_HOST=your-db.endpoint.REGION.rds.amazonaws.com
DB_NAME=agecm_revised
DB_USER=agecm_app
DB_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
INGESTION_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
THINGSPEAK_NODE1_CHANNEL_ID=REPLACE_WITH_NODE_01_CHANNEL_ID
THINGSPEAK_NODE1_READ_KEY=REPLACE_WITH_NODE_01_READ_KEY
THINGSPEAK_NODE2_CHANNEL_ID=REPLACE_WITH_NODE_02_CHANNEL_ID
THINGSPEAK_NODE2_READ_KEY=REPLACE_WITH_NODE_02_READ_KEY
REPORT_INTERVAL_SECONDS=20
STALE_SECONDS=65
CLOUD_POLL_SECONDS=5
